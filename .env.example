# =============================================================================
# Finance ERP — Environment Variables Example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
#
# Usage with Docker Compose:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up -d
# =============================================================================

# =========================
# PostgreSQL Configuration
# =========================
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me_in_production

# =========================
# Redis Configuration
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================
# API Gateway
# =========================
API_GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:8085
MARKETPLACE_SERVICE_URL=http://localhost:8086
ORDER_SERVICE_URL=http://localhost:8087
FINANCE_SERVICE_URL=http://localhost:8082

# =========================
# JWT RS256 Configuration
# =========================
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRY_MS=86400000
