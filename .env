# =============================================================================
# Finance ERP — Environment Variables Example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
#
# Usage with Docker Compose:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up -d
# =============================================================================

# =========================
# PostgreSQL Configuration
# =========================
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me_in_production

# =========================
# API Gateway
# =========================
# Port on which the API Gateway listens
API_GATEWAY_PORT=8080

# Downstream service URLs (use Docker service names in Docker Compose)
PAYROLL_SERVICE_URL=http://payroll-service:8081
FINANCE_SERVICE_URL=http://finance-service:8082

# =========================
# Payroll Service
# =========================
PAYROLL_SERVER_PORT=8081
PAYROLL_DB_URL=jdbc:postgresql://postgres:5432/payroll_db
PAYROLL_DB_USERNAME=erp_user
PAYROLL_DB_PASSWORD=change_me_in_production

# gRPC connection to Finance Service
# Use Docker service name in Docker Compose, localhost for local development
FINANCE_GRPC_HOST=finance-service
FINANCE_GRPC_PORT=9090

# gRPC deadline for Finance Service calls.
# Format: "5s" = 5 seconds, "2000ms" = 2 seconds.
# Without a deadline, a slow Finance Service could block Payroll threads indefinitely.
GRPC_DEADLINE=5s

# Finance REST URL (for benchmark comparison only)
FINANCE_REST_URL=http://finance-service:8082
FINANCE_REST_TIMEOUT=5

# =========================
# Finance Service
# =========================
FINANCE_SERVER_PORT=8082
FINANCE_GRPC_SERVER_PORT=9090
FINANCE_DB_URL=jdbc:postgresql://postgres:5432/finance_db
FINANCE_DB_USERNAME=erp_user
FINANCE_DB_PASSWORD=change_me_in_production

# =========================
# Production Security Notes
# =========================
# In production, the following additional configuration is required:
#
# 1. TLS for gRPC:
#    GRPC_TLS_CERT_CHAIN=/certs/server.crt
#    GRPC_TLS_PRIVATE_KEY=/certs/server.key
#
# 2. mTLS for service authentication:
#    GRPC_TRUST_CERT=/certs/ca.crt
#    GRPC_CLIENT_CERT=/certs/payroll.crt
#    GRPC_CLIENT_KEY=/certs/payroll.key
#
# 3. JWT / Service tokens for application-level auth:
#    GRPC_SERVICE_TOKEN=your-service-token
#    JWT_SECRET=your-jwt-secret
#
# 4. Network policies: restrict gRPC port (9090) to internal network only.
#    Finance Service gRPC should NEVER be accessible from the public internet.
